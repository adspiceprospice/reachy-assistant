# HeyRobo Codex relay settings.
# This file is for the machine that runs Codex, not for Reachy Mini.

# Use a long random token and paste the same value into the Reachy app settings.
HEY_ROBO_CODEX_RELAY_TOKEN=

# Bind to all interfaces so Reachy can reach this machine over WiFi.
HEY_ROBO_RELAY_HOST=0.0.0.0
HEY_ROBO_RELAY_PORT=8766

# Allowlisted workspaces. Format: id=/absolute/path;other=/absolute/path
# The app setting "Default workspace ID" must match one of these ids.
HEY_ROBO_CODEX_WORKSPACES=current=/absolute/path/to/a/git/repo

# Codex CLI binary. Use an absolute path if "codex" is not on PATH for the relay shell.
HEY_ROBO_CODEX_BINARY=codex

# Relay task logs are written here.
HEY_ROBO_CODEX_TASK_LOG_DIR=~/.hey_robo/codex_tasks
