# Local HeyRobo settings. Do not put real secrets in committed files.
OPENAI_API_KEY=
MODEL_NAME=gpt-realtime-2
HEY_ROBO_REALTIME_REASONING_EFFORT=low
HEY_ROBO_WAKE_PHRASE=HEY ROBO
HEY_ROBO_WAKE_ENABLED=true
HEY_ROBO_WAKE_MODEL_PATH=
HEY_ROBO_WAKE_MIN_CONFIDENCE=0.60
HEY_ROBO_WAKE_REARM_DELAY_SECONDS=3
HEY_ROBO_WAKE_SESSION_TIMEOUT_SECONDS=45
HEY_ROBO_STATE_POSES_ENABLED=true
HEY_ROBO_STANDBY_POSE_MODE=sleep_off
HEY_ROBO_STANDBY_DISABLE_MOTORS=true
HEY_ROBO_ACTIVE_POSE_PITCH_DEGREES=-18
# Only used when HEY_ROBO_STANDBY_POSE_MODE=pose.
HEY_ROBO_STANDBY_POSE_PITCH_DEGREES=24
HEY_ROBO_REALTIME_VOICE=cedar
HEY_ROBO_CODEX_RELAY_URL=http://127.0.0.1:8766
HEY_ROBO_CODEX_RELAY_TOKEN=
HEY_ROBO_CODEX_DEFAULT_WORKSPACE=current
